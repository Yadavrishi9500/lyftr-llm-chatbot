# Comma-separated provider keys (at least 2). Ids are assigned in order: key_1, key_2, ...
# Use keys from two separate Google AI Studio projects so their quotas are independent.
LLM_API_KEYS=replace-with-gemini-key-1,replace-with-gemini-key-2
LLM_MODEL=gemini/gemini-2.0-flash
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
# "true" enables the X-Simulate-Failure request header (demo/testing only).
ENABLE_FAILURE_SIMULATION=true
# Baked into the frontend bundle at build time.
VITE_API_BASE_URL=http://localhost:8000
